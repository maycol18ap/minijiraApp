@model MiniJiraApp.Models.Entities.Tarea
@{
    ViewData["Title"] = "Eliminar Tarea";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <h2 class="mb-4 text-danger"><i class="bi bi-exclamation-triangle"></i> Eliminar Tarea</h2>
        <div class="alert alert-warning">
            ¿Estás seguro de que deseas eliminar esta tarea? Esta acción no se puede deshacer.
        </div>
        <div class="card shadow-sm">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">Título</dt>
                    <dd class="col-sm-9">@Model.Titulo</dd>

                    <dt class="col-sm-3">Descripción</dt>
                    <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Descripcion) ? "—" : Model.Descripcion)</dd>

                    <dt class="col-sm-3">Estado</dt>
                    <dd class="col-sm-9">@Model.Estado</dd>
                </dl>
            </div>
        </div>
        <form asp-action="Delete" method="post" class="mt-3 d-flex justify-content-between">
            <input type="hidden" asp-for="Id" />
            <a asp-controller="Proyectos" asp-action="Details" asp-route-id="@Model.ProyectoId" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Cancelar
            </a>
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash"></i> Sí, eliminar
            </button>
        </form>
    </div>
</div>
