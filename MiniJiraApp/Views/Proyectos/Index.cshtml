@model IEnumerable<MiniJiraApp.Models.Entities.Proyecto>
@{
    ViewData["Title"] = "Proyectos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-folder2-open text-primary"></i> Proyectos</h2>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Nuevo Proyecto
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> No hay proyectos registrados. ¡Crea el primero!
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th class="text-center">Tareas</th>
                    <th>Fecha Creación</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var proyecto in Model)
                {
                    <tr>
                        <td class="fw-semibold">@proyecto.Nombre</td>
                        <td>@(string.IsNullOrEmpty(proyecto.Descripcion) ? "—" : proyecto.Descripcion)</td>
                        <td class="text-center">
                            <span class="badge bg-secondary">@proyecto.Tareas.Count</span>
                        </td>
                        <td>@proyecto.FechaCreacion.ToString("dd/MM/yyyy")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@proyecto.Id" class="btn btn-sm btn-info text-white" title="Detalles">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@proyecto.Id" class="btn btn-sm btn-primary" title="Editar">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@proyecto.Id" class="btn btn-sm btn-danger" title="Eliminar">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
