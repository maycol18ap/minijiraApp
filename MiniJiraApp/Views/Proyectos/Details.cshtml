@model MiniJiraApp.Models.Entities.Proyecto
@{
    ViewData["Title"] = "Detalle del Proyecto";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-folder text-primary"></i> @Model.Nombre</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Volver a Proyectos
    </a>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <h5 class="card-title">Información del Proyecto</h5>
        <dl class="row mb-0">
            <dt class="col-sm-3">Descripción</dt>
            <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Descripcion) ? "—" : Model.Descripcion)</dd>

            <dt class="col-sm-3">Fecha de Creación</dt>
            <dd class="col-sm-9">@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</dd>

            <dt class="col-sm-3">Total de Tareas</dt>
            <dd class="col-sm-9"><span class="badge bg-secondary">@Model.Tareas.Count</span></dd>
        </dl>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="bi bi-list-task"></i> Tareas</h4>
    <a asp-controller="Tareas" asp-action="Create" asp-route-proyectoId="@Model.Id" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Nueva Tarea
    </a>
</div>

@if (!Model.Tareas.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> Este proyecto aún no tiene tareas.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Título</th>
                    <th>Descripción</th>
                    <th class="text-center">Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tarea in Model.Tareas)
                {
                    <tr>
                        <td class="fw-semibold">@tarea.Titulo</td>
                        <td>@(string.IsNullOrEmpty(tarea.Descripcion) ? "—" : tarea.Descripcion)</td>
                        <td class="text-center">
                            @{
                                var claseBadge = tarea.Estado switch
                                {
                                    "Completado" => "bg-success",
                                    "En Progreso" => "bg-primary",
                                    _ => "bg-warning text-dark"
                                };
                            }
                            <span class="badge @claseBadge">@tarea.Estado</span>
                        </td>
                        <td class="text-end">
                            <a asp-controller="Tareas" asp-action="Edit" asp-route-id="@tarea.Id" class="btn btn-sm btn-primary" title="Editar">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-controller="Tareas" asp-action="Delete" asp-route-id="@tarea.Id" class="btn btn-sm btn-danger" title="Eliminar">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
